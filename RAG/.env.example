# Copy this to .env and fill in your keys — never commit .env itself

OPENAI_API_KEY=sk-...
FANAR_API_KEY=...

QDRANT_URL=https://your-cluster.us-east-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=...

# Durable application records (feedback + chat sessions). Use the connection
# URL from managed PostgreSQL (Neon, Supabase, Railway, Render, etc.).
# Required when ENVIRONMENT=production. Leave empty for local SQLite/in-memory.
# Supabase production example: use the Session pooler string and append sslmode=require.
DATABASE_URL=
REQUIRE_DATABASE=false

# RAG is optional. The dashboard and exports do not depend on Qdrant.
# true + working Qdrant: full semantic RAG
# true + missing/deleted Qdrant: SQL/Pandas structured-chat fallback
# false: dashboard-only, lowest memory
ENABLE_RAG=true

# Set true only when a deployment must refuse startup without RAG credentials.
REQUIRE_RAG=false

# The cross-encoder loads lazily by default to keep API startup responsive.
WARM_RERANKER_ON_STARTUP=false
WARM_EMBEDDING_ON_STARTUP=true
ENABLE_HYBRID_RETRIEVAL=false
ENABLE_RERANKER=false

# Drops raw Arabic/page-content blobs after deriving dashboard signals. This
# lowers runtime memory on small hosts; offline index building still loads full text.
COMPACT_RUNTIME_DATA=true

# Origins allowed to call the FastAPI backend (comma-separated)
# Set this to your deployed frontend URL in production
ALLOWED_ORIGINS=http://localhost:3000

# Optional: LLM response timeout in seconds (default 30)
LLM_TIMEOUT_SECONDS=20

# ── Environment / release ────────────────────────────────────────────────────
# "development" (default) or "production". Production validates CORS and,
# when REQUIRE_RAG=true, refuses startup if RAG credentials are missing.
ENVIRONMENT=development
APP_VERSION=0.1.0-dev

# Log level: DEBUG | INFO (default) | WARNING | ERROR
LOG_LEVEL=INFO

# ── Observability (all optional — features activate when set) ────────────────
# Sentry error tracking: create a project at sentry.io, paste its DSN here.
# sentry-sdk is already a dependency; setting this is the ONLY step needed.
# SENTRY_DSN=

# Langfuse LLM tracing: create a project at cloud.langfuse.com, paste its
# keys below. langfuse is already a dependency — setting these is the only
# step needed. Traces wrap every chat completion automatically.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Prometheus needs no configuration — metrics are always exposed at /metrics
# (blocked from external access by nginx in production; see OBSERVABILITY.md).

# ── Optional research retrieval layers ──────────────────────────────────────
# BM25/RRF and cross-encoder reranking are off in the production default because
# they added 10–13 seconds per semantic question on the target CPU. Enable them
# only for an explicit retrieval-quality experiment.
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
